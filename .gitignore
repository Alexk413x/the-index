.claude-plugin/types/

# Per-project local config
.claude/*.local.md

# codebase-kg working file: a snapshot, not a source.
.kg-export.json

# Python bytecode from the vendored git hooks
__pycache__/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
node_modules/
