# Normalize line endings: store LF in the repo, check out native.
* text=auto eol=lf

# Keep shell + python LF even on Windows checkouts.
*.sh text eol=lf
*.py text eol=lf

# Markdown/JSON/TypeScript are text.
*.md text
*.json text
*.ts text
*.tsx text

*.db binary

# codebase-kg's code map of this repo. With the textconv driver that
# .githooks/install.sh registers, git renders it as JSON in diffs.
knowledge/code_graph.db binary diff=codegraph
